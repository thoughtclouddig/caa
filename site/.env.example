# Local development.
# Replit sets DATABASE_URL for you when you attach a PostgreSQL database;
# you do not need this file there.
#
# Copy to .env.local and adjust, then:
#   npm run db:setup     (creates the schema and seeds the starting data)
#   npm run dev

DATABASE_URL=postgres://localhost:5432/caa_dev

# Newsletter sending, through Resend (resend.com).
# Without these the site runs normally: people can subscribe, issues
# publish to the public archive, and only sending waits.
#
# NEWSLETTER_FROM must be an address on a domain verified in Resend.
# SITE_URL is used for links and images inside emails, which cannot be
# relative.
RESEND_API_KEY=
NEWSLETTER_FROM=Catholic Aviation Association <news@catholicaviation.org>
SITE_URL=http://localhost:3000
